{
  "name": "peek-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src e2e scripts *.ts *.mts *.json *.mjs",
    "format:check": "prettier --check src e2e scripts *.ts *.mts *.json *.mjs",
    "test:e2e": "playwright test",
    "dev:fixtures": "node scripts/fixture-api.mjs",
    "test:fixtures": "node --test scripts/fixture-api.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^30.1.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}
