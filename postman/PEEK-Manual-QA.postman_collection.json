          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/commands/{{fiscalCommandId}}", "description": "Comprova confirmação e retenção do identificador fiscal externo." },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Fiscal confirmado', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.status).to.eql('CONFIRMED'); pm.expect(body.externalDocumentId).to.eql('INV-' + pm.collectionVariables.get('runId')); });"], "type": "text/javascript" } }]
