{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:peek:jev:input:1.0",
  "title": "PEEK JEV E02 sanitized input v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "exceptionCode", "ruleTriggered", "dataClassification", "expectedState", "observedState", "facts", "calculations", "configuration", "recentEvents", "historyTruncated"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "exceptionCode": {"const": "E02"},
    "ruleTriggered": {"const": "abs(physicalStock - expectedStock) > tolerance"},
    "dataClassification": {"const": "SYNTHETIC_DEMO"},
    "expectedState": {
      "type": "object", "additionalProperties": false, "required": ["expectedStock"],
      "properties": {"expectedStock": {"type": "number"}}
    },
    "observedState": {
      "type": "object", "additionalProperties": false, "required": ["physicalStock"],
      "properties": {"physicalStock": {"type": "number", "minimum": 0}}
    },
    "facts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/fact"}},
    "calculations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/calculation"}},
    "configuration": {
      "type": "object", "additionalProperties": false, "required": ["tolerance", "evidenceId"],
      "properties": {"tolerance": {"type": "number", "minimum": 0}, "evidenceId": {"$ref": "#/$defs/evidenceId"}}
    },
    "recentEvents": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/event"}},
    "historyTruncated": {"type": "boolean"}
  },
  "$defs": {
    "evidenceId": {"type": "string", "pattern": "^e[1-9][0-9]?$"},
    "sourceRef": {"type": "string", "pattern": "^source[1-9][0-9]?$"},
    "eventType": {"enum": ["STOCK_UPDATED", "SALE_CONFIRMED", "GOODS_RECEIVED", "PHYSICAL_COUNT", "STOCK_ADJUSTED"]},
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "eventType", "sourceRef", "secondsBeforeCount", "value", "confirmed"],
      "properties": {
        "id": {"$ref": "#/$defs/evidenceId"},
        "kind": {"enum": ["PHYSICAL_COUNT", "BASELINE", "CHECKPOINT", "MOVEMENT"]},
        "eventType": {"$ref": "#/$defs/eventType"},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "secondsBeforeCount": {"type": "integer", "minimum": 0},
        "value": {"type": "number"}, "confirmed": {"type": "boolean"}
      }
    },
    "calculation": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "value"],
      "properties": {"id": {"$ref": "#/$defs/evidenceId"}, "kind": {"enum": ["expectedStock", "delta"]}, "value": {"type": "number"}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["eventRef", "type", "sourceRef", "secondsBeforeCount", "quantity", "stockAfter", "confirmed"],
      "properties": {
        "eventRef": {"type": "string", "pattern": "^event[1-9][0-9]?$"},
        "type": {"$ref": "#/$defs/eventType"}, "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "secondsBeforeCount": {"type": "integer", "minimum": 0},
        "quantity": {"type": ["number", "null"]}, "stockAfter": {"type": ["number", "null"]}, "confirmed": {"type": "boolean"}
      }
    }
  }
}
