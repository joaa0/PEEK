PEEK_DB_URL=jdbc:postgresql://localhost:5432/peek
PEEK_DB_USER=peek
PEEK_DB_PASSWORD=peek_local_only
PEEK_DB_PORT=5432

# Backend process environment; dotenv files are NOT loaded by Spring Boot.
# External requests require profile demo, fictitious Demo products/events, and both flags.
PEEK_LLM_ENABLED=false
PEEK_LLM_SYNTHETIC_DEMO=false
PEEK_LLM_ENDPOINT=https://api.typesafe.ai/v1/systemone
PEEK_LLM_MODEL=jev-latest
PEEK_LLM_API_KEY=
PEEK_LLM_TIMEOUT=10s
PEEK_LLM_CONNECT_TIMEOUT=3s
